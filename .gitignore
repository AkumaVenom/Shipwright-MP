Thumbs.db

# This directory is SOURCE, despite its build- prefix.
!/build-helper/
# Bundled upstream source templates, not generated local build products.
!/torch/lib/StormLib/**/*.vcxproj
!/torch/lib/StormLib/**/*.vcxproj.filters
!/torch/lib/StormLib/**/*.sln
!/torch/lib/StormLib/src/StormLib.exp
